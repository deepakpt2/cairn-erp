      { "code": "HRA", "name": "House rent allowance", "kind": "EARNING", "debit": "500000", "credit": null, "receiver": "ASSIGNMENT" },
      { "code": "CONVEY", "name": "Conveyance allowance", "kind": "EARNING", "debit": "500000", "credit": null, "receiver": "ASSIGNMENT" },
