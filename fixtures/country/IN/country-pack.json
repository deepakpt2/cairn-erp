  "taxCodes": {
    "$comment": "This product models ONE rate per document line and ONE TAX determination account per chart. A GST invoice therefore carries a single consolidated rate here, not a CGST + SGST pair. The rates are the statutory headline rates; the *split* and the *place-of-supply decision* are GAPs (02-gap-list.md A1-A3).",
    "standardTaxAccount": "220000",
    "codes": [
      { "code": "G18", "name": "GST 18% — standard", "taxType": "MWS", "ratePercent": "18.00", "accountKey": "MWS", "appliesTo": "Fabricated steel products, consumables at 18%" },
      { "code": "G12", "name": "GST 12% — reduced", "taxType": "MWS", "ratePercent": "12.00", "accountKey": "MWS", "appliesTo": "Certain inputs; used here for packing materials" },
      { "code": "G05", "name": "GST 5% — reduced", "taxType": "MWS", "ratePercent": "5.00", "accountKey": "MWS", "appliesTo": "Not used in the base scenario; available" },
      { "code": "G28", "name": "GST 28% — luxury", "taxType": "MWS", "ratePercent": "28.00", "accountKey": "MWS", "appliesTo": "Not used in the base scenario; available" },
      { "code": "GZ0", "name": "GST 0% — export / zero-rated", "taxType": "MWS", "ratePercent": "0.00", "accountKey": "MWS", "appliesTo": "Foreign customer export invoice" },
      { "code": "GEX", "name": "GST exempt", "taxType": "MWS", "ratePercent": "0.00", "accountKey": "MWS", "appliesTo": "Exempt supply; not used in the base scenario" }
    ],
    "targetEntries": {
      "$comment": "Shown in the UAT guide as TARGET (GAP) beside the entry the product actually posts. Intra-state at 18%: CGST 9% + SGST 9%. Inter-state at 18%: IGST 18%.",
      "intraState": { "cgstAccount": "220100", "sgstAccount": "220200", "inputCgst": "140100", "inputSgst": "140200", "rate": "9.00+9.00" },
      "interState": { "igstAccount": "220300", "inputIgst": "140300", "rate": "18.00" }
    }
  },
  "payrollStatutory": {
    "$comment": "Configured approximations posted through the payroll engine as pay components, NOT statutory computation. PF is a flat 12% of the structure base. ESI is 0.75%/3.25% applied only to employees the fixture marks as under the wage ceiling; there is no ceiling rule in the engine. Professional tax is a flat monthly amount. TDS u/s 192 is a pre-calculated fixed monthly amount per employee. See 02-gap-list.md B1-B2.",
    "components": [
      { "code": "PFEE", "name": "Provident fund — employee 12%", "kind": "DEDUCTION", "debit": null, "credit": "251100", "receiver": "NONE", "rule": { "kind": "PERCENT_OF_BASE", "value": "12" } },
      { "code": "PFER", "name": "Provident fund — employer 12%", "kind": "EMPLOYER_CONTRIBUTION", "debit": "500400", "credit": "251100", "receiver": "ASSIGNMENT", "rule": { "kind": "PERCENT_OF_BASE", "value": "12" } },
      { "code": "ESIEE", "name": "ESI — employee 0.75%", "kind": "DEDUCTION", "debit": null, "credit": "251200", "receiver": "NONE", "rule": { "kind": "PERCENT_OF_BASE", "value": "0.75" } },
      { "code": "ESIER", "name": "ESI — employer 3.25%", "kind": "EMPLOYER_CONTRIBUTION", "debit": "500500", "credit": "251200", "receiver": "ASSIGNMENT", "rule": { "kind": "PERCENT_OF_BASE", "value": "3.25" } },
      { "code": "PTAX", "name": "Professional tax — Maharashtra", "kind": "DEDUCTION", "debit": null, "credit": "251300", "receiver": "NONE", "rule": { "kind": "FIXED", "value": "200" } },
      { "code": "TDS192", "name": "TDS u/s 192 — salary", "kind": "DEDUCTION", "debit": null, "credit": "251400", "receiver": "NONE", "rule": { "kind": "FIXED", "value": "0", "gapNote": "Per-employee monthly amount; see the employee's tdsMonthly in company/IN01." } }
