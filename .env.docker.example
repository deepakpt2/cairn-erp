# Copy to .env.docker (ignored by Git) and chmod 600 .env.docker.
# Generate three DIFFERENT values with: openssl rand -hex 32
# DB passwords must be URL-safe: letters/digits/_/- only (hex is recommended).
CAIRN_OWNER_DB_PASSWORD=
CAIRN_APP_DB_PASSWORD=
SESSION_SECRET=

# Keep this agreed hostname; a different hostname also needs the action-origin config changed.
CAIRN_HOST=cairn.deepakpt.com
# CAIRN_ENV is fixed to production by the Compose services.
# Never put a GitHub token in this file. .env.local is excluded from the image build.
