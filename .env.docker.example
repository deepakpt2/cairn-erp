# Legacy optional filename. Prefer .env.example -> .env and plain docker compose.
# Kept for existing installations that deliberately select an env file.
# Default Docker Compose configuration: copy to .env (ignored by Git).
# Existing deployments: KEEP your current .env; do not overwrite saved secrets.
# chmod 600 .env
# Generate three DIFFERENT values with: openssl rand -hex 32
# Database passwords must be URL-safe (hex is recommended).
CAIRN_OWNER_DB_PASSWORD=
CAIRN_APP_DB_PASSWORD=
SESSION_SECRET=

# Separate owner-only provisioning token (openssl rand -hex 32). Blank disables web provisioning.
# Every tenant creation requires this token: the first tenant and every later one alike.
# It is the only gate, and it is also what grants the tenant its platform administrator.
CAIRN_PROVISIONING_TOKEN=

# Optional demo dataset. false (or unset) leaves the deployment empty, which is the
# default. true provisions a complete fictional company automatically, once, on the
# first start — and only into a database holding no business data of any kind.
# Provisioning is refused rather than destructive: an existing tenant, user, document
# or posting stops it, and the application is not started over a refused install.
ENABLE_DUMMY_DATA=false

# Optional: host uid/gid to own ./credentials/demo-credentials.txt so you can read it
# without sudo. Leave blank to have the file owned by the container user.
# echo "$(id -u):$(id -g)"
CAIRN_DEMO_CREDENTIALS_UID=
CAIRN_DEMO_CREDENTIALS_GID=

CAIRN_HOST=cairn.deepakpt.com
# CAIRN_ENV and database URLs are set explicitly by Compose; no env-file flag is needed.
# Do not put GitHub credentials here; .env.local stays private and out of image context.
