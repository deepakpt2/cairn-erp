# Optional local Node/PostgreSQL development settings, not the Compose template.
# Copy to .env only when running the application directly without Docker.
# Development-only defaults; replace all passwords/secrets before deployment.
# Provision the separate PostgreSQL roles as described in CAIRN.md.
DATABASE_URL=postgresql://cairn_app:cairn_app_dev@127.0.0.1:5432/cairn
MIGRATION_DATABASE_URL=postgresql://cairn:cairn_dev@127.0.0.1:5432/cairn
SESSION_SECRET=replace-with-a-long-random-secret-before-use
APP_BASE_URL=http://localhost:3000
CAIRN_ENV=development
