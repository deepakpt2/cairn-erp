# Default Docker Compose configuration: copy to .env (ignored by Git).
# Existing deployments: KEEP your current .env; do not overwrite saved secrets.
# chmod 600 .env
# Generate four DIFFERENT values with: openssl rand -hex 32
# Database passwords must be URL-safe (hex is recommended).
# All Compose services use this same database name. Set it before first DB startup;
# changing it does not rename a database in an existing PostgreSQL volume.
# For the walkthrough, use a fresh disposable name: cairn_migration_test_YYYYMMDD_<run-id>.
CAIRN_DATABASE_NAME=cairn
CAIRN_OWNER_DB_PASSWORD=
CAIRN_APP_DB_PASSWORD=
# Migration role cairn_integration_migrator; URL-safe (hex: openssl rand -hex 32)
CAIRN_MIGRATOR_DB_PASSWORD=
SESSION_SECRET=

# Separate owner-only provisioning token (openssl rand -hex 32). Blank disables web provisioning.
# First tenant: token required. Later tenants: signed-in authorized admin AND token required.
CAIRN_PROVISIONING_TOKEN=

# Optional bank-data keyring: inject only through the deployment secret channel.
# Strict JSON shape: {"activeKeyId":"key-current","keys":{"key-current":"<43-char base64url encoding of 32 random bytes>"}}
# Retain prior key IDs/material through verified re-encryption; never commit actual key values.
# CAIRN_BANK_DATA_KEYRING_JSON=

# Private, durable storage for generated salary payment CSVs (encrypted envelopes), held in the named volume
# `payment_files` mounted at /app/payment-files — outside the source checkout and web root. Only override the
# mount path if you supply your own durable volume; if you use a host bind mount instead, its ownership must let
# the app UID/GID 1001 read and write (see docs/fresh-server-installation.md §3b). Share it across instances.
# CAIRN_PAYMENT_FILE_MOUNT=/app/payment-files

CAIRN_HOST=cairn.deepakpt.com
# CAIRN_ENV and database URLs are set explicitly by Compose; no env-file flag is needed.
# Do not put GitHub credentials here; .env.local stays private and out of image context.
