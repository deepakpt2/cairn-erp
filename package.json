{
  "name": "cairn",
  "version": "0.1.0",
  "private": true,
  "description": "Cairn \u2014 enterprise resource planning system",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "worker": "tsx src/worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx src/platform/db/migrate.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:ip": "tsx scripts/lint-ip.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "bootstrap:reset": "tsx scripts/bootstrap.ts --reset",
    "seed:reference": "tsx scripts/seed-reference.ts",
    "dev:tenant": "tsx scripts/create-dev-tenant.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "smoke:posting": "tsx scripts/smoke-posting.ts",
    "smoke:browser": "tsx scripts/browser-smoke.ts",
    "smoke:browser:foundation": "tsx scripts/browser-smoke.ts --target foundation",
    "smoke:browser:material-basic": "tsx scripts/browser-smoke.ts --target material-basic",
    "smoke:browser:material-purchasing": "tsx scripts/browser-smoke.ts --target material-purchasing",
    "smoke:browser:material-mrp": "tsx scripts/browser-smoke.ts --target material-mrp",
    "smoke:browser:material-valuation": "tsx scripts/browser-smoke.ts --target material-valuation",
    "test:browser-harness": "vitest run --config vitest.browser-harness.config.ts",
    "db:sync-role": "tsx scripts/sync-db-app-role.ts",
    "smoke:browser:payment-terms": "tsx scripts/browser-smoke.ts --target payment-terms",
    "smoke:browser:business-partners": "tsx scripts/browser-smoke.ts --target business-partners",
    "smoke:browser:supplier-company": "tsx scripts/browser-smoke.ts --target supplier-company"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.4",
    "next": "^15.1.6",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
