{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // These five tracked files are documentation snippets, not independently executable modules.
  // The runnable walkthrough remains the root walkthrough-seed.ts and stays in the project scope.
  "exclude": [
    "node_modules",
    "notes/walk-a.ts",
    "notes/walk-b.ts",
    "notes/walk-c.ts",
    "notes/walk-d.ts",
    "notes/walk-e.ts"
  ]
}
