{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // These five tracked files are documentation snippets, not independently executable modules.
  // The walkthrough seed and the two dev modules only it ever imported are retired: tenant
  // creation and onboarding moved to the owner-token gate and demo provisioning, the seed no
  // longer matches the service contracts, and it is not made to match them. It is out of the
  // type-checked project until it is deleted; nothing else in the repository imports it.
  "exclude": [
    "node_modules",
    "notes/walk-a.ts",
    "notes/walk-b.ts",
    "notes/walk-c.ts",
    "notes/walk-d.ts",
    "notes/walk-e.ts",
    "walkthrough-seed.ts",
    "src/dev/walkthrough-volume.ts",
    "src/dev/walkthrough-asset.ts"
  ]
}
