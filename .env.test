# Test environment for the workbench container. Loaded by tests/test-env.ts, which every
# vitest config imports, and by `npm run test:db:*`. Tests must NEVER run against erp_dev:
# the loader refuses any DATABASE_URL / MIGRATION_DATABASE_URL naming a different database.
#
# No secrets in this file: both passwords are documented development values.
# Migrations run as cairn_integration_migrator (LOGIN, BYPASSRLS, owner of the database), the role
# drizzle/0000_baseline.sql assigns every object to and the SECURITY DEFINER functions rely on.
# The runtime role is the restricted cairn_app role.
CAIRN_ENV=development
TEST_DATABASE_NAME=erp_test
DATABASE_URL=postgresql://cairn_app:cairn_app_dev@postgres:5432/erp_test
MIGRATION_DATABASE_URL=postgresql://cairn_integration_migrator:cairn_migrator_dev@postgres:5432/erp_test

# Read by src/platform/db/target-guard.ts for its identity check (defaults point at 127.0.0.1).
CAIRN_DB_HOST=postgres
CAIRN_DB_PORT=5432
CAIRN_DB_USER=cairn_app
CAIRN_DB_PASSWORD=cairn_app_dev
